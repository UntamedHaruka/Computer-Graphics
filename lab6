import pygame

pygame.init()
screen = pygame.display.set_mode((800, 500))
pygame.display.set_caption("3D Transformations")

# Original cube
cube1 = [(100,150), (200,150), (200,250), (100,250),
         (150,100), (250,100), (250,200), (150,200)]

# Transformed cube
cube2 = [(400,150), (550,150), (550,300), (400,300),
         (475,75), (625,75), (625,225), (475,225)]

edges = [(0,1),(1,2),(2,3),(3,0),
         (4,5),(5,6),(6,7),(7,4),
         (0,4),(1,5),(2,6),(3,7)]

running = True
while running:
    screen.fill("white")

    for cube in [cube1, cube2]:
        for a, b in edges:
            pygame.draw.line(screen, "blue", cube[a], cube[b], 3)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    pygame.display.update()

pygame.quit()
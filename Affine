import matplotlib.pyplot as plt

# Original square
x = [1, 3, 3, 1, 1]
y = [1, 1, 3, 3, 1]

# Translation + Scaling
new_x = [i * 1.5 + 3 for i in x]
new_y = [i * 1.5 + 2 for i in y]

# Draw original object
plt.plot(x, y, label="Original")

# Draw transformed object
plt.plot(new_x, new_y, label="Composite Transformation")

plt.grid()
plt.axis("equal")
plt.legend()
plt.title("Composite and Affine Transformations")
plt.xlabel("X-axis")
plt.ylabel("Y-axis")

plt.show()
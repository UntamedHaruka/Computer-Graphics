import matplotlib.pyplot as plt

# Clipping window
xmin, ymin = 2, 2
xmax, ymax = 8, 8

# Original line
x1, y1 = 0, 4
x2, y2 = 10, 6

# Draw clipping window
plt.plot(
    [xmin, xmax, xmax, xmin, xmin],
    [ymin, ymin, ymax, ymax, ymin]
)

# Draw original line
plt.plot([x1, x2], [y1, y2], "--")

# Simple clipped line
plt.plot([xmin, xmax], [4.4, 5.6], linewidth=3)

plt.xlim(0, 10)
plt.ylim(0, 10)
plt.grid()
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Line Clipping Algorithm")

plt.show()
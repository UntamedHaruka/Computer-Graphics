import matplotlib.pyplot as plt

# 3D points
x = [1, 3, 3, 1, 1]
y = [1, 1, 3, 3, 1]
z = [1, 1, 3, 3, 1]

# 2D perspective projection
d = 5
x2 = [a * d / (c + d) for a, c in zip(x, z)]
y2 = [b * d / (c + d) for b, c in zip(y, z)]

# 3D view
fig = plt.figure()

ax = fig.add_subplot(121, projection="3d")
ax.plot(x, y, z)
ax.set_title("3D View")

# 2D view
ax = fig.add_subplot(122)
ax.plot(x2, y2, "o-")
ax.set_title("2D Perspective View")
ax.grid()

plt.show()
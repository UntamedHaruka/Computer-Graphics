import tkinter as tk

root = tk.Tk()
root.title("Addition of 2 Numbers")
root.geometry("600x700")

canvas = tk.Canvas(root, width=600, height=700, bg="white")
canvas.pack()

# -------------------------------
# START
# -------------------------------
canvas.create_oval(
    210, 30, 390, 90,
    fill="green",
    outline="black"
)

canvas.create_text(
    300, 60,
    text="START",
    font=("Arial", 14, "bold")
)

# -------------------------------
# INPUT A
# -------------------------------
canvas.create_rectangle(
    180, 140, 420, 210,
    fill="lightblue",
    outline="black"
)

canvas.create_text(
    300, 175,
    text="Input A & B",
    font=("Arial", 14, "bold")
)

# -------------------------------
# SUM = A + B
# -------------------------------
canvas.create_rectangle(
    180, 260, 420, 330,
    fill="yellow",
    outline="black"
)

canvas.create_text(
    300, 295,
    text="SUM = A + B",
    font=("Arial", 14, "bold")
)

# -------------------------------
# DISPLAY SUM
# -------------------------------
canvas.create_rectangle(
    180, 380, 420, 450,
    fill="orange",
    outline="black"
)

canvas.create_text(
    300, 415,
    text="Display SUM",
    font=("Arial", 14, "bold")
)

# -------------------------------
# END
# -------------------------------
canvas.create_oval(
    220, 500, 380, 560,
    fill="lightgreen",
    outline="black"
)

canvas.create_text(
    300, 530,
    text="END",
    font=("Arial", 14, "bold")
)

# -------------------------------
# ARROWS
# -------------------------------

# START -> Input
canvas.create_line(
    300, 90, 300, 140,
    arrow=tk.LAST,
    width=2
)

# Input -> Sum
canvas.create_line(
    300, 210, 300, 260,
    arrow=tk.LAST,
    width=2
)

# Sum -> Display
canvas.create_line(
    300, 330, 300, 380,
    arrow=tk.LAST,
    width=2
)

# Display -> End
canvas.create_line(
    300, 450, 300, 500,
    arrow=tk.LAST,
    width=2
)

root.mainloop()
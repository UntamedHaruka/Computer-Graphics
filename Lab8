import matplotlib.pyplot as plt

x1, y1 = 0, 0
x2, y2 = 10, 10

dx = x2 - x1
dy = y2 - y1
p = 2 * dy - dx

x, y = x1, y1
points = []

while x <= x2:
    points.append((x, y))

    if p >= 0:
        y += 1
        p += 2 * (dy - dx)
    else:
        p += 2 * dy

    x += 1

x, y = zip(*points)

# Draw straight line through Bresenham points
plt.plot(x, y, marker="o")

plt.grid()
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Bresenham's Line Drawing Algorithm")
plt.show()
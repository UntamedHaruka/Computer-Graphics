import pygame

pygame.init()

screen = pygame.display.set_mode((600, 500))
pygame.display.set_caption("Polygon Filling - Flood Fill")

WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
BLUE = (0, 150, 255)

polygon = [(200, 100), (400, 150), (350, 350), (150, 300)]

def flood_fill(x, y):
    old_color = screen.get_at((x, y))
    if old_color[:3] != WHITE:
        return

    stack = [(x, y)]

    while stack:
        x, y = stack.pop()

        if 0 <= x < 600 and 0 <= y < 500:
            if screen.get_at((x, y))[:3] == WHITE:
                screen.set_at((x, y), BLUE)

                stack.append((x + 1, y))
                stack.append((x - 1, y))
                stack.append((x, y + 1))
                stack.append((x, y - 1))

screen.fill(WHITE)

pygame.draw.polygon(screen, BLACK, polygon, 2)

flood_fill(250, 200)

pygame.display.update()

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

pygame.quit()
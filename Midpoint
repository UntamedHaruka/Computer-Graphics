import matplotlib.pyplot as plt

xc, yc = 0, 0
rx, ry = 10, 6

x, y = 0, ry
rx2, ry2 = rx * rx, ry * ry
dx, dy = 0, 2 * rx2 * y

points_x = []
points_y = []

p1 = ry2 - rx2 * ry + 0.25 * rx2

# Region 1
while dx < dy:
    points_x += [xc+x, xc-x, xc+x, xc-x]
    points_y += [yc+y, yc+y, yc-y, yc-y]

    x += 1
    dx += 2 * ry2

    if p1 < 0:
        p1 += dx + ry2
    else:
        y -= 1
        dy -= 2 * rx2
        p1 += dx - dy + ry2

# Region 2
p2 = ry2*(x+0.5)**2 + rx2*(y-1)**2 - rx2*ry2

while y >= 0:
    points_x += [xc+x, xc-x, xc+x, xc-x]
    points_y += [yc+y, yc+y, yc-y, yc-y]

    y -= 1
    dy -= 2 * rx2

    if p2 > 0:
        p2 += rx2 - dy
    else:
        x += 1
        dx += 2 * ry2
        p2 += dx - dy + rx2

plt.plot(points_x, points_y, "o")
plt.grid()
plt.axis("equal")
plt.title("Midpoint Ellipse Drawing Algorithm")
plt.show()
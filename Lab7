import matplotlib.pyplot as plt

x1, y1 = 0, 0
x2, y2 = 10, 8

dx = x2 - x1
dy = y2 - y1

steps = max(abs(dx), abs(dy))
x_inc = dx / steps
y_inc = dy / steps

x, y = x1, y1
points = []

for i in range(steps + 1):
    points.append((round(x), round(y)))
    x += x_inc
    y += y_inc

x, y = zip(*points)

plt.plot(x, y, "o-")
plt.grid()
plt.title("DDA Line Drawing")
plt.show()
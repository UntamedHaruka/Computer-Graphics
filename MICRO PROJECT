import numpy as np
import matplotlib.pyplot as plt

# Input vectors
A = np.array([4, 3])
B = np.array([3, 1])

# Calculations
dot_product = np.dot(A, B)
magnitude_B = np.linalg.norm(B)

projection = (dot_product / np.dot(B, B)) * B
perpendicular = A - projection

# Create graph
plt.figure(figsize=(10, 7))

# Vectors
plt.quiver(0, 0, A[0], A[1],
           angles='xy', scale_units='xy', scale=1,
           label='Vector A')

plt.quiver(0, 0, B[0], B[1],
           angles='xy', scale_units='xy', scale=1,
           label='Vector B')

plt.quiver(0, 0, projection[0], projection[1],
           angles='xy', scale_units='xy', scale=1,
           label='Projection')

plt.quiver(projection[0], projection[1],
           perpendicular[0], perpendicular[1],
           angles='xy', scale_units='xy', scale=1,
           label='Perpendicular Component')

# IMPORTANT: Mark the points
points_x = [0, B[0], projection[0], A[0]]
points_y = [0, B[1], projection[1], A[1]]

plt.scatter(points_x, points_y, s=80, zorder=5)

# Point labels
plt.annotate("O (0,0)", (0, 0),
             xytext=(8, -15), textcoords="offset points",
             fontsize=11)

plt.annotate("B (3,1)", (3, 1),
             xytext=(8, 8), textcoords="offset points",
             fontsize=11)

plt.annotate("Projection (4.5,1.5)", (4.5, 1.5),
             xytext=(-100, 10), textcoords="offset points",
             fontsize=11)

plt.annotate("A (4,3)", (4, 3),
             xytext=(8, 8), textcoords="offset points",
             fontsize=11)

# Data box
data = (
    f"Dot Product = {dot_product}\n"
    f"|B| = {magnitude_B:.2f}\n"
    f"Projection = ({projection[0]:.1f}, {projection[1]:.1f})\n"
    f"Perpendicular = ({perpendicular[0]:.1f}, {perpendicular[1]:.1f})"
)

plt.text(
    -0.8, -1.2,
    data,
    fontsize=10,
    bbox=dict(
        boxstyle="round,pad=0.5",
        facecolor="white",
        edgecolor="black"
    )
)

# Graph settings
plt.xlim(-1, 5.2)
plt.ylim(-1.5, 4)
plt.xticks(range(-1, 6))
plt.yticks(range(-1, 5))

plt.grid(True)
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Vector Projection and Component Decomposition")
plt.legend()

plt.show()
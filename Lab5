import pygame
import math

pygame.init()
screen = pygame.display.set_mode((700, 500))
pygame.display.set_caption("Rotation and Reflection")

points = [(100, 100), (200, 100), (200, 200), (100, 200)]

# Rotate 45 degrees
rotated = []
for x, y in points:
    x, y = x - 150, y - 150
    rotated.append((x * math.cos(math.pi/4) - y * math.sin(math.pi/4) + 400,
                    x * math.sin(math.pi/4) + y * math.cos(math.pi/4) + 150))

# Reflection
reflected = [(x, 400 - y) for x, y in points]

running = True
while running:
    screen.fill("white")

    pygame.draw.polygon(screen, "blue", points, 2)
    pygame.draw.polygon(screen, "red", rotated, 2)
    pygame.draw.polygon(screen, "green", reflected, 2)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    pygame.display.update()

pygame.quit()